{
  "manifestVersion": 1,
  "id": "pr-dashboard",
  "publisher": "carlos-baixo",
  "name": "Pull Requests Dashboard",
  "version": "1.3.0",
  "description": "My open pull requests with status, next move owner, linked sessions, stacks, session cost and mute.",
  "engines": {
    "orca": ">=1.4.248"
  },
  "pluginApi": 1,
  "main": "src/main.mjs",
  "contributes": {
    "commands": [
      {
        "id": "open-pull-requests",
        "title": "Open Pull Requests",
        "context": "global"
      },
      {
        "id": "refresh-pull-requests",
        "title": "Refresh Pull Requests",
        "context": "global"
      },
      {
        "id": "show-pull-requests-panel",
        "title": "Show Pull Requests Panel",
        "context": "global"
      }
    ],
    "panels": [
      {
        "id": "pull-requests",
        "title": "Pull Requests",
        "icon": "branch",
        "entry": "src/page.html"
      }
    ],
    "statusBarItems": [
      {
        "id": "attention",
        "icon": "branch",
        "text": "PRs",
        "tooltip": "Pull requests that need your attention. Click to open the panel.",
        "command": "show-pull-requests-panel"
      }
    ],
    "settings": [
      {
        "key": "agent",
        "title": "Agent for Discuss and Fix",
        "description": "The agent that Discuss and Fix workspaces start with.",
        "type": "string",
        "default": "claude",
        "enum": ["claude", "codex", "copilot", "cursor", "gemini", "opencode"],
        "enumLabels": ["Claude Code", "Codex", "GitHub Copilot", "Cursor", "Gemini", "OpenCode"]
      }
    ]
  },
  "capabilities": [
    {
      "kind": "notifications:show"
    },
    {
      "kind": "settings:own"
    },
    {
      "kind": "storage:own"
    }
  ]
}
